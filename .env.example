# ---- Optional: leave blank to run in DEMO MODE (in-memory data, zero setup) ----

# Upstash Redis (free tier) for persistence across devices / serverless instances.
# Both must be set to enable it. Values are JSON with a 24 h TTL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Hugging Face: LangGraph + RAG triage. Server-side only - never prefix with NEXT_PUBLIC.
# Without a key the app uses its built-in deterministic triage knowledge base,
# with keyword retrieval for the "Why this diagnosis" citations.
HUGGINGFACE_API_KEY=
# Chat model on the HF router (OpenAI-compatible). ":groq" pins a provider with structured output.
HF_MODEL=openai/gpt-oss-20b:groq
# Multilingual embedding model (Hindi/Hinglish). Must match the one data/index.json was built with.
HF_EMBED_MODEL=intfloat/multilingual-e5-small

# Voice assistant (SOS mic). Server-side only.
# Bhashini ULCA credentials: https://bhashini.gov.in/ulca -> My Profile -> generate API key.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# Optional overrides (defaults shown)
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
# Ollama running Qwen locally
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
